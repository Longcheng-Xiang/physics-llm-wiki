# Optional for the Files viewer. Required only for API-backed Chat.
OPENAI_API_KEY=

# `openai` keeps the original API-backed website path.
# `codex_cli` makes the backend call local `codex exec --json` instead.
AGENT_BACKEND=openai

# Model and thinking level for the website agent.
# Reasoning effort is commonly low, medium, or high.
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium

# Used only when AGENT_BACKEND=codex_cli.
CODEX_BINARY=codex
CODEX_MODEL=

WIKI_VAULT_ROOT=
MAX_AGENT_ITERATIONS=80
MAX_OUTPUT_TOKENS=32000
WORKFLOW_B_PRIMARY_SOURCE_READ_SYNTHESIS_THRESHOLD=8
MAX_FILE_LINES_WITHOUT_RANGE=800
SEARCH_MATCH_LIMIT=50
SEARCH_OUTPUT_LIMIT=20000
